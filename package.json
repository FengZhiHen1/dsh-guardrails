{
  "name": "dsh-guardrails",
  "version": "0.5.1",
  "description": "Execution and file safeguards, sensitive-file approvals and credential masking for DSH",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FengZhiHen1/dsh-guardrails.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./client": "./src/client/settings.js",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node verify/run-verify.mjs",
    "verify": "node verify/run-verify.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.2"
  },
  "files": [
    "index.js",
    "icon.svg",
    "src/",
    "vendor/",
    "docs/",
    "locale/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-locale"] },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
