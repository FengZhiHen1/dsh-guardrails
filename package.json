{
  "name": "dsh-guardrails",
  "version": "1.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FengZhiHen1/dsh-guardrails.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./src/client/card.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check src/core/rules.js && node --check src/core/path-check.js && node --check src/core/command.js && node --check src/core/destructive.js && node --check src/core/deny-messages.js && node --check src/core/check-command.js && node --check src/adapter/host.js && node --check src/client/card.js && node --test test/*.test.mjs",
    "verify": "node verify/run-verify.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
