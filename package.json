{
  "name": "dsh-guardrails",
  "version": "3.0.0",
  "description": "Official Shell AST guard, precise sensitive-file approvals and credential redaction for DSH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FengZhiHen1/dsh-guardrails.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node verify/run-verify.mjs",
    "verify": "node verify/run-verify.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
