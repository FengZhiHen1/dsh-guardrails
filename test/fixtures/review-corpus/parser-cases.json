    {"id": "PS-PARAM-02", "dialect": "powershell", "group": "ps-parameter", "source": "Remove-Item C:\\synthetic\\x -Recurse:$false", "expectedCommands": [{"name": "Remove-Item", "args": ["C:\\synthetic\\x", "-Recurse:$false"]}], "expectedDecision": "needs-evidence", "implementationStatus": "implemented", "preFixObserved": "['C:\\\\synthetic\\\\x','-Recurse',null]（值折叠为 null）", "reason": "官方语义：-Recurse:$false 为非递归删除（仍是删除）。修订后以合并 token '-Recurse:$false' 表达，保留真假可判；删除事实不丢", "stage": "post-fix-observed", "residual": "core recursive 检测只认裸 '-recurse'，故 -Recurse:$false 时 recursive=false（语义正确），而 -Recurse:$true 同样不含裸 token -> 需 core 用『开关名+值』二元组判定，否则 -Recurse:$true 会被低估为非递归"},
